# Copy to .env and fill in what you have. Everything is optional: a source without its key is shown as "needs key".

DATABASE_URL=postgresql+psycopg://selfanalytics:selfanalytics@127.0.0.1:5544/selfanalytics
REDIS_URL=redis://127.0.0.1:6380/0

# --- Local models (native Ollama) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EXTRACT_MODEL=qwen3:4b
OLLAMA_ASSISTANT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=bge-m3

# --- Job APIs ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
CAREERJET_API_KEY=
USAJOBS_EMAIL=
USAJOBS_API_KEY=
REED_API_KEY=
FINDWORK_API_KEY=
FRANCETRAVAIL_CLIENT_ID=
FRANCETRAVAIL_CLIENT_SECRET=

# --- Search discovery ---
BRAVE_API_KEY=
TAVILY_API_KEY=
SEARXNG_URL=http://127.0.0.1:8888

# --- Free cloud LLM fallback (public job data only; a CV is never sent unless you opt in on the CV page) ---
# LLM_FALLBACK: none | gemini | groq | openrouter
LLM_FALLBACK=none
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional password for the hosted app. Leave empty for local use.
APP_PASSWORD=


